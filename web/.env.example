# Server-side only (never prefix with NEXT_PUBLIC_). Set in Vercel project env vars.
ANTHROPIC_API_KEY=
# Optional model override for the AI assistant.
ANTHROPIC_MODEL=claude-opus-5-5

# DEVELOPMENT ONLY: load the synthetic fixture instead of public/data/*.json.
# Ignored in production builds. Shows a red "SIMULATED DATA" banner.
NEXT_PUBLIC_USE_FIXTURE=0
